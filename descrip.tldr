							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Event bubbling"
								},
								{
									"type": "text",
									"text": " is a core concept in JavaScript's event handling system. It describes the process where an event, triggered on a specific element, travels or \"bubbles up\" through its ancestors in the DOM tree, from the target element all the way to the "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "document"
								},
								{
									"type": "text",
									"text": " object. This behavior is enabled by default. "
								}
							]
						}
					]
				}
			},
