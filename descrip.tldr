		{
			"x": 1096.32123446192,
			"y": 265.75616649759615,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:y7R4eN2TN07GPOsiWU1yE",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1224.394128330574,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "bulletList",
							"content": [
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Core Concept:"
												},
												{
													"type": "text",
													"text": " Event bubbling is the process where an event triggered on a nested element travels up through its parent elements in the DOM tree."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Direction of Flow:"
												},
												{
													"type": "text",
													"text": " The propagation path is from the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "inside out"
												},
												{
													"type": "text",
													"text": "—starting from the specific target element and moving upwards towards the root ("
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "document"
												},
												{
													"type": "text",
													"text": ")."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Default Behavior:"
												},
												{
													"type": "text",
													"text": " This is the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "default"
												},
												{
													"type": "text",
													"text": " and most common way browsers handle event propagation."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Execution Order:"
												},
												{
													"type": "text",
													"text": " The event listener on the innermost (child) element executes "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "first"
												},
												{
													"type": "text",
													"text": ", followed by its parent, and then its grandparent, and so on."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Stopping Propagation:"
												},
												{
													"type": "text",
													"text": " You can stop the event from continuing its upward journey by calling the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														},
														{
															"type": "code"
														}
													],
													"text": "event.stopPropagation()"
												},
												{
													"type": "text",
													"text": " method within any event listener."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Primary Use Case (Event Delegation):"
												},
												{
													"type": "text",
													"text": " Its most powerful application is "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "event delegation"
												},
												{
													"type": "text",
													"text": ". By placing a single event listener on a parent element, you can efficiently manage events for many child elements, which improves performance and simplifies code."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Contrast with Capturing:"
												},
												{
													"type": "text",
													"text": " Event bubbling is the second phase of event propagation. It happens "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "after"
												},
												{
													"type": "text",
													"text": " the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "event capturing"
												},
												{
													"type": "text",
													"text": " phase, where the event travels from the root down to the target element. Bubbling is the more commonly used of the two phases."
												}
											]
										}
									]
								}
							]
						}
					]
				}
			},
